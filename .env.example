# Example Environment Configuration for Slack Leak
# Copy this file to .env and fill in your actual credentials

# =============================================================================
# JIRA CONFIGURATION (REQUIRED for creating alerts)
# =============================================================================
JIRA_SERVER=https://yourcompany.atlassian.net
JIRA_USERNAME=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=SECURITY

# =============================================================================
# SLACK CONFIGURATION (OPTIONAL - for Slack channel scanning)
# =============================================================================
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# =============================================================================
# CONFLUENCE CONFIGURATION (OPTIONAL - for Confluence scanning)
# =============================================================================
CONFLUENCE_URL=https://yourcompany.atlassian.net/wiki
CONFLUENCE_USERNAME=your-email@example.com
CONFLUENCE_API_TOKEN=your-confluence-api-token

# =============================================================================
# NOTES:
# =============================================================================
# 1. If using the same Atlassian instance for Jira and Confluence,
#    you can use the same credentials for both
# 
# 2. Generate Atlassian API tokens at:
#    https://id.atlassian.com/manage-profile/security/api-tokens
#
# 3. Create a Slack app and get the bot token at:
#    https://api.slack.com/apps
#
# 4. Make sure to set appropriate permissions for each service
#
# 5. Keep this file secure and never commit it to version control